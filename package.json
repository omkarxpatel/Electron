{
  "name": "audio-visualizer",
  "productName": "Electron",
  "private": true,
  "version": "1.0.4",
  "description": "Local macOS audio visualizer + system-wide EQ + Spotify control surface.",
  "homepage": "https://github.com/omkarxpatel/Electron",
  "repository": {
    "type": "git",
    "url": "https://github.com/omkarxpatel/Electron.git"
  },
  "license": "MIT",
  "author": "Omkar Patel",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && electron-builder",
    "build:unpack": "tsc --noEmit && vite build && electron-builder --dir",
    "build:publish": "tsc --noEmit && vite build && electron-builder --publish=always",
    "typecheck": "tsc --noEmit",
    "icon:gen": "bash scripts/build-icon.sh"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.omkar.audiovisualizer",
    "productName": "Electron",
    "artifactName": "Electron-${version}-${arch}.${ext}",
    "copyright": "Copyright © 2026 Omkar Patel",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "type": "distribution"
    },
    "dmg": {
      "title": "Electron ${version}",
      "icon": "build/icon.icns",
      "iconSize": 110,
      "background": null,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "omkarxpatel",
      "repo": "Electron",
      "releaseType": "release"
    }
  }
}
