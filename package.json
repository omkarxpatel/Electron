{
  "name": "audio-visualizer",
  "productName": "Audio Visualizer & Modifier",
  "private": true,
  "version": "0.1.0",
  "description": "Local macOS audio visualizer",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && electron-builder",
    "build:unpack": "tsc --noEmit && vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.omkar.audiovisualizer",
    "productName": "Audio Visualizer",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg"
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    }
  }
}
